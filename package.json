{
	"name": "josunlp-website",
	"version": "2.0.0",
	"description": "Personal portfolio and open-source presence of Jonas Pfalzgraf (JosunLP)",
	"type": "module",
	"private": true,
	"license": "MIT",
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"dev": "tsx scripts/dev.ts",
		"build": "npm run generate:blog-manifest && npm run generate:blog-sitemap && vite build && npm run prerender && tsx scripts/postbuild.ts",
		"prerender": "tsx scripts/prerender.ts",
		"generate:csp-hash": "tsx scripts/generate-csp-hash.ts",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:a11y": "vitest run tests/a11y",
		"validate": "tsx scripts/validate-dist.ts",
		"generate:blog-manifest": "tsx scripts/generate-blog-manifest.ts",
		"generate:blog-sitemap": "tsx scripts/generate-blog-sitemap.ts",
		"check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build && npm run validate"
	},
	"dependencies": {
		"@bquery/bquery": "^1.15.1",
		"highlight.js": "^11.11.1",
		"marked": "^18.0.6"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@tailwindcss/vite": "^4.3.2",
		"@types/node": "^24.1.0",
		"axe-core": "^4.11.0",
		"eslint": "^10.6.0",
		"eslint-config-prettier": "^10.1.0",
		"happy-dom": "^20.0.0",
		"jsdom": "^29.1.1",
		"prettier": "^3.9.0",
		"tailwindcss": "^4.3.2",
		"tsx": "^4.23.0",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.46.0",
		"vite": "^8.1.4",
		"vitest": "^4.1.10"
	},
	"allowScripts": {
		"esbuild@0.28.1": true
	}
}
