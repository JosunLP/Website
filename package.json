{
	"name": "josunlp-website",
	"version": "2.1.1",
	"description": "Personal portfolio and open-source presence of Jonas Pfalzgraf (JosunLP)",
	"type": "module",
	"private": true,
	"license": "MIT",
	"engines": {
		"bun": ">=1.4.0"
	},
	"scripts": {
		"dev": "bun scripts/dev.ts",
		"build": "bun run generate:og-image && bun run generate:blog-manifest && bun run generate:blog-sitemap && bun run generate:blog-feeds && vite build && bun run prerender && bun scripts/postbuild.ts && bun run precompress",
		"prerender": "bun scripts/prerender.ts",
		"precompress": "bun scripts/precompress.ts",
		"generate:og-image": "bun scripts/generate-og-image.ts",
		"generate:csp-hash": "bun scripts/generate-csp-hash.ts",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:a11y": "vitest run tests/a11y",
		"validate": "bun scripts/validate-dist.ts",
		"generate:blog-manifest": "bun scripts/generate-blog-manifest.ts",
		"generate:blog-sitemap": "bun scripts/generate-blog-sitemap.ts",
		"generate:blog-feeds": "bun scripts/generate-blog-feeds.ts",
		"check": "bun run typecheck && bun run lint && bun run format:check && bun run test && bun run build && bun run validate"
	},
	"dependencies": {
		"@bquery/bquery": "^1.18.0",
		"highlight.js": "^11.12.0",
		"marked": "^18.1.1"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.5",
		"axe-core": "^4.14.0",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"happy-dom": "^20.14.6",
		"jsdom": "^30.1.3",
		"prettier": "^3.9.10",
		"tailwindcss": "^4.3.3",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.72.0",
		"vite": "^8.3.5",
		"vitest": "^4.1.12"
	},
	"trustedDependencies": [
		"esbuild",
		"@tailwindcss/oxide"
	]
}
