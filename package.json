{
	"name": "josunlp-website",
	"version": "2.0.0",
	"description": "Personal portfolio and open-source presence of Jonas Pfalzgraf (JosunLP)",
	"type": "module",
	"private": true,
	"license": "MIT",
	"engines": {
		"bun": ">=1.2.0"
	},
	"scripts": {
		"dev": "bun scripts/dev.ts",
		"build": "bun run generate:blog-manifest && bun run generate:blog-sitemap && vite build && bun run prerender && bun scripts/postbuild.ts",
		"prerender": "bun scripts/prerender.ts",
		"generate:csp-hash": "bun scripts/generate-csp-hash.ts",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:a11y": "vitest run tests/a11y",
		"validate": "bun scripts/validate-dist.ts",
		"generate:blog-manifest": "bun scripts/generate-blog-manifest.ts",
		"generate:blog-sitemap": "bun scripts/generate-blog-sitemap.ts",
		"check": "bun run typecheck && bun run lint && bun run format:check && bun run test && bun run build && bun run validate"
	},
	"dependencies": {
		"@bquery/bquery": "^1.15.1",
		"highlight.js": "^11.11.1",
		"marked": "^18.0.6"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@tailwindcss/vite": "^4.3.2",
		"@types/node": "^24.1.0",
		"axe-core": "^4.11.0",
		"eslint": "^10.6.0",
		"eslint-config-prettier": "^10.1.0",
		"happy-dom": "^20.0.0",
		"jsdom": "^29.1.1",
		"prettier": "^3.9.0",
		"tailwindcss": "^4.3.2",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.46.0",
		"vite": "^8.1.4",
		"vitest": "^4.1.10"
	},
	"trustedDependencies": [
		"esbuild",
		"@tailwindcss/oxide"
	]
}
